<section id="contact" class="py-12 border-t border-[#ffffff10]">
  <div class="max-w-5xl mx-auto">
    <h2 class="text-lg text-[var(--sec)] mb-2 shiny-sec">Poznaj moją ekipę</h2>
    <h3 class="text-4xl md:text-5xl font-medium mb-8 text-[var(--white)]">Zespół wsparcia</h3>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
      <div class="border border-[var(--white-icon-tr)] rounded-2xl p-5 bg-[#1414149c] hover:border-[var(--sec)] transition-colors duration-300">
        <img
          src="/pets/piesek.JPEG" 
          alt="Mój pies"
          class="w-full aspect-square object-cover rounded-xl mb-4"
        />
        <h4 class="text-2xl font-semibold text-[var(--white)]">Luna</h4>
        <span class="block text-sm font-medium text-[var(--sec)] mt-1 mb-3">
          Junior Developer
        </span>
        <p class="mt-2 text-[var(--white-icon)]">
          Pełna energii, ciągle w biegu i zawsze chętna do zabawy kosztem snu. Uwielbia leżeć na plecach i domagać się głaskania. Choć bywa małą niezdarą, w Babalu widzi swój największy autorytet.
        </p>
      </div>
      <div class="border border-[var(--white-icon-tr)] rounded-2xl p-5 bg-[#1414149c] hover:border-[var(--sec)] transition-colors duration-300">
        <img
          src="/pets/kot_drzewo.JPEG" 
          alt="Mój kot"
          class="w-full aspect-square object-cover rounded-xl mb-4"
        />
        <h4 class="text-2xl font-semibold text-[var(--white)]">Babalu</h4>
        <span class="block text-sm font-medium text-[var(--sec)] mt-1 mb-3">
          Senior Tech Lead
        </span>
        <p class="mt-2 text-[var(--white-icon)]">
          Oaza spokoju z 16-letnim stażem. Czuwa przy biurku podczas każdego projektu, asystując przy nauce i pisaniu kodu. Po godzinach bezbłędna wspinaczka drzew i niezrównana łowczyni myszy.
        </p>
      </div>
    </div>
  </div>
</section>

<script type="module" is:inline>
  const form = document.getElementById("contact-form");
  const formMessage = document.getElementById("form-message");

  form.addEventListener("submit", async (e) => {
    e.preventDefault();
    const formData = new FormData(form);

    try {
      const response = await fetch(form.action, {
        method: "POST",
        body: formData,
        headers: { Accept: "application/json" },
      });
      if (response.ok) {
        form.reset();
        form.style.display = "none";
        formMessage.classList.remove("hidden");
      } else {
        const data = await response.json();
        console.error("Error response:", data);
        alert("There was a problem sending your message.");
      }
    } catch (error) {
      console.error("Error:", error);
      alert("There was a problem sending your message.");
    }
  });
</script>
